# =============================================================================
# Nono Orbe — configuração local
# =============================================================================
#
# Copie este arquivo:
#   cp .env.example .env
#
# Altere todas as variáveis marcadas com TROQUE.
# Nunca envie o arquivo .env ao Git.

# Aplicação
ORBE_PROJECT_SLUG=local
ORBE_PORT=9000
ORBE_TZ=America/Sao_Paulo

# MySQL 8.4
#
# A porta é publicada somente em 127.0.0.1.
ORBE_DB_PORT=9001
ORBE_DB_NAME=webfarm_orbe
ORBE_DB_USER=nono_orbe
ORBE_DB_PASSWORD=TROQUE_A_SENHA_DO_USUARIO
ORBE_DB_ROOT_PASSWORD=TROQUE_A_SENHA_ROOT